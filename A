package com.yourpackage

import android.content.Context
import android.graphics.*
import android.util.AttributeSet
import android.view.View

class RaceView(context: Context, attrs: AttributeSet?) : View(context, attrs) {

    // Player car
    var playerX = 400f
    val playerY get() = height - 300f
    val playerWidth = 80f
    val playerHeight = 140f

    // Enemy car
    var enemyX = 300f
    var enemyY = -200f
    val enemyWidth = 80f
    val enemyHeight = 140f
    var enemySpeed = 15f

    // Road lines
    var lineY = 0f
    val lineSpeed = 20f

    // Score
    var score = 0
    var gameOver = false

    val playerPaint = Paint().apply { color = Color.BLUE }
    val enemyPaint = Paint().apply { color = Color.RED }
    val roadPaint = Paint().apply { color = Color.WHITE }
    val textPaint = Paint().apply {
        color = Color.WHITE
        textSize = 60f
        typeface = Typeface.DEFAULT_BOLD
    }

    fun moveLeft() { if (!gameOver) playerX -= 40f }
    fun moveRight() { if (!gameOver) playerX += 40f }

    fun update() {
        if (gameOver) return

        // Move road lines
        lineY += lineSpeed
        if (lineY > height) lineY = 0f

        // Move enemy
        enemyY += enemySpeed
        if (enemyY > height) {
            enemyY = -200f
            enemyX = (100..width - 100).random().toFloat()
            score++
            enemySpeed += 0.5f // gets faster each time
        }

        // Collision detection
        val playerRect = RectF(playerX, playerY, playerX + playerWidth, playerY + playerHeight)
        val enemyRect = RectF(enemyX, enemyY, enemyX + enemyWidth, enemyY + enemyHeight)
        if (RectF.intersects(playerRect, enemyRect)) {
            gameOver = true
        }

        // Keep player inside screen
        playerX = playerX.coerceIn(50f, width - playerWidth - 50f)
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)

        // Draw road lines
        for (i in 0..5) {
            canvas.drawRect(width / 2f - 10, lineY + i * 200f, width / 2f + 10, lineY + i * 200f + 100, roadPaint)
        }

        // Draw player car
        canvas.drawRect(playerX, playerY, playerX + playerWidth, playerY + playerHeight, playerPaint)

        // Draw enemy car
        canvas.drawRect(enemyX, enemyY, enemyX + enemyWidth, enemyY + enemyHeight, enemyPaint)

        // Draw score
        canvas.drawText("Score: $score", 40f, 80f, textPaint)

        // Game over screen
        if (gameOver) {
            textPaint.textSize = 100f
            canvas.drawText("GAME OVER", width / 2f - 250f, height / 2f, textPaint)
            textPaint.textSize = 60f
            canvas.drawText("Score: $score", width / 2f - 100f, height / 2f + 100f, textPaint)
        }
    }
}
